{
  "actorSpecification": 1,
  "name": "funding-radar",
  "title": "Funding Rate API - Perp DEX Funding & Arbitrage",
  "description": "Live perpetual funding rates and fee-adjusted funding-arbitrage opportunities across 8 decentralized perp DEXs.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "readme": "../README.md",
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Funding rates / arbitrage opportunities",
      "views": {
        "arbitrage": {
          "title": "Arbitrage opportunities",
          "transformation": {
            "fields": [
              "symbol", "short_venue", "short_apr",
              "long_venue", "long_apr", "net_apr", "min_oi_usd"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "symbol": { "label": "Coin" },
              "short_venue": { "label": "Short venue" },
              "short_apr": { "label": "Short APR" },
              "long_venue": { "label": "Long venue" },
              "long_apr": { "label": "Long APR" },
              "net_apr": { "label": "Net APR" },
              "min_oi_usd": { "label": "Min leg OI (USD)" }
            }
          }
        }
      }
    }
  }
}
